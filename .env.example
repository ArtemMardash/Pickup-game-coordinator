# Frontend settings. Copy to `.env` (never commit `.env`).
# Vite exposes VITE_* variables to the browser, so never put secrets here.

# Base URL of the backend API.
VITE_API_URL=http://localhost:8000

# Google Maps (map, pins, address search, location filter, geocoding).
# This key is visible to the browser, so RESTRICT it in Google Cloud:
# HTTP referrers = your site(s) (e.g. http://localhost:5173/*), and API
# restrictions = Maps JavaScript API, Places API (New), Geocoding API.
# Leave blank to run without the map (it shows a placeholder).
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Cloud-styled Map ID. Defaults to Google's DEMO_MAP_ID, which is
# fine for development; create your own Map ID for production.
VITE_GOOGLE_MAPS_MAP_ID=
