# Local development settings. Copy to `.env` (never commit `.env`).
# These values match backend/docker-compose.yml.

# Use 127.0.0.1, not "localhost": on some machines localhost resolves to IPv6
# first and the Docker-published (IPv4-only) port never answers.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pug
DB_USER=pug_app
# Choose your own password for the local Docker database (required: docker
# compose and the backend both refuse to start without it). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
# Docker applies it the first time the database container is created.
DB_PASSWORD=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated origins allowed to call the API from the browser.
# Must include the frontend's URL (see VITE_API_URL in the root .env.example).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
